#!/usr/bin/env bash
# This file was generated by The Circus, a plugin by [l'Aicluse](https://laicluse.com).
# Do not edit by hand. Change the upstream source and regenerate.
set -euo pipefail

CODEX_MARKETPLACE_FILE=".agents/plugins/marketplace.json"
CLAUDE_MARKETPLACE_FILE=".claude-plugin/marketplace.json"
CODEX_HOOK_ADAPTER_REVISION="hooks.2"

die() {
  printf 'circus plugins: %s\n' "$1" >&2
  exit 1
}

repo_root() {
  local repo="${1:-$PWD}"
  (cd "$repo" 2>/dev/null && pwd) || die "directory does not exist: ${1:-$PWD}"
}

require_marketplace() {
  local repo="$1"
  [ -f "$repo/$CLAUDE_MARKETPLACE_FILE" ] || die "missing $CLAUDE_MARKETPLACE_FILE in $repo"
}

validate_source() {
  local name="$1" source="$2"
  case "$source" in
    ./*) ;;
    *) die "plugin $name source must start with ./: $source" ;;
  esac
  [ "$source" != "./" ] || die "plugin $name source may not be the repo root"
  case "$source" in *../*|*/..|../*) die "plugin $name source may not escape the repo: $source" ;; esac
}

display_name() {
  jq -nr --arg name "$1" '$name | split("-") | map(if length > 0 then (.[0:1] | ascii_upcase) + .[1:] else . end) | join(" ")'
}

codex_plugin_payload() {
  local manifest="$1" plugin="$2" cachebuster="${3:-}"
  jq -n --slurpfile manifest "$manifest" --arg plugin "$plugin" --arg category "Productivity" --arg cachebuster "$cachebuster" '
    def titlecase: split("-") | map(if length > 0 then (.[0:1] | ascii_upcase) + .[1:] else . end) | join(" ");
    def shortdesc: if length <= 120 then . else .[0:117] + "..." end;
    ($manifest[0]) as $m |
    ($m.description // "") as $desc |
    (($m.author | if type == "object" then .name else . end) // "local") as $author |
    {
      name: $m.name,
      version: (if $cachebuster == "" then $m.version else (($m.version | split("+")[0]) + "+codex." + $cachebuster) end),
      description: $desc,
      author: {
	name: ($author | tostring)
      },
      keywords: (($m.keywords // []) + [$plugin, "agent-skills"] | unique),
      skills: "./skills/",
      interface: {
	displayName: ($m.displayName // ($m.name | titlecase)),
	shortDescription: ($desc | shortdesc),
	longDescription: $desc,
	developerName: ($author | tostring),
	category: $category,
	capabilities: ["Read"],
	defaultPrompt: ["Use the " + ($m.name | titlecase) + " plugin."]
      }
    }
    + (if ($m.repository // "") != "" then {repository: $m.repository} else {} end)
    + (if ($m.homepage // "") != "" then {homepage: $m.homepage} else {} end)
    + (if ($m.license // "") != "" then {license: $m.license} else {} end)
  '
}

codex_marketplace_entry() {
  local name="$1" source="$2"
  jq -n --arg name "$name" --arg source "$source" --arg category "Productivity" '
    {
      name: $name,
      source: {
	source: "local",
	path: $source
      },
      policy: {
	installation: "AVAILABLE",
	authentication: "ON_INSTALL"
      },
      category: $category
    }
  '
}

needs_sanitized_skills() {
  local plugin_dir="$1"
  grep -R -E -q '^[[:space:]]*(argument[-_]hint|disable[-_]model[-_]invocation|effort|optional|scope|user[-_]invocable):' "$plugin_dir/skills" 2>/dev/null
}

has_agent_specific_skills() {
  local plugin_dir="$1"
  find "$plugin_dir/skills" -type f \( -name 'SKILL.claude.md' -o -name 'SKILL.codex.md' \) | grep -q .
}

has_skill_source_for_agent() {
  local plugin_dir="$1" agent="$2" skill_dir
  for skill_dir in "$plugin_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    if skill_source_for_agent "$skill_dir" "$agent" >/dev/null; then
      return 0
    fi
  done
  return 1
}

has_codex_hooks() {
  local plugin_dir="$1"
  [ -f "$plugin_dir/hooks/hooks.codex.json" ]
}

validate_codex_hooks_config() {
  local plugin="$1" path="$2"
  jq -e 'type == "object" and (keys == ["hooks"]) and (.hooks | type == "object")' "$path" >/dev/null ||
    die "plugin $plugin Codex hooks config must have exactly one top-level hooks key: $path"
}

codex_hook_command() {
  local plugin="$1" event="$2" command="$3" marker prefix remainder runtime_path trailing message bootstrap
  marker='${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}'
  case "$command" in
    *"$marker"*) ;;
    *) printf '%s\n' "$command"; return 0 ;;
  esac

  prefix="${command%%"$marker"*}"
  remainder="${command#*"$marker"}"
  runtime_path="${remainder%% *}"
  trailing="${remainder#"$runtime_path"}"
  case "$runtime_path" in
    /*) ;;
    *) die "plugin $plugin $event hook has an invalid plugin-root command: $command" ;;
  esac

  bootstrap='loaded_root="${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}"; plugin_data="${PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-}}"; runtime_root="$loaded_root"; '
  bootstrap+='case "$loaded_root" in */plugins/cache/*/*/*) version="${loaded_root##*/}"; retained_base="$plugin_data/.runtime/hooks"; retained_link="$retained_base/by-version/$version"; '
  bootstrap+='if [ -x "$retained_link'"$runtime_path"'" ]; then runtime_root="$retained_link"; else source_root="$loaded_root"; '
  bootstrap+='if [ ! -x "$source_root'"$runtime_path"'" ]; then plugin_base="${loaded_root%/*}"; source_root=""; source_count=0; for candidate in "$plugin_base"/*; do if [ -d "$candidate" ] && [ -x "$candidate'"$runtime_path"'" ]; then source_root="$candidate"; source_count=$((source_count + 1)); fi; done; [ "$source_count" -eq 1 ] || source_root=""; fi; '
  bootstrap+='if [ -n "$source_root" ] && [ -n "$plugin_data" ]; then original_umask="$(umask)"; umask 077; mkdir -p "$retained_base/snapshots" "$retained_base/by-version"; '
  bootstrap+='if [ -L "$retained_link" ] && [ ! -e "$retained_link" ]; then rm -f "$retained_link"; fi; '
  bootstrap+='stage="$(mktemp -d "$retained_base/snapshots/$version.XXXXXX")" || stage=""; published=0; source_version="${source_root##*/}"; '
  bootstrap+='if [ -n "$stage" ] && cp -R "$source_root/." "$stage" && printf '\''%s\n'\'' "$source_version" > "$stage/.circus-source-version" && [ -x "$stage'"$runtime_path"'" ] && ln -sn "../snapshots/${stage##*/}" "$retained_link" 2>/dev/null; then published=1; fi; '
  bootstrap+='if [ -x "$retained_link'"$runtime_path"'" ]; then runtime_root="$retained_link"; else runtime_root="$source_root"; fi; '
  bootstrap+='if [ -n "$stage" ] && [ "$published" -eq 0 ]; then rm -rf "$stage"; fi; umask "$original_umask"; else runtime_root="$source_root"; fi; fi ;; esac; '
  bootstrap+='hook_entry="$runtime_root'"$runtime_path"'"; export PLUGIN_ROOT="$runtime_root" CLAUDE_PLUGIN_ROOT="$runtime_root"; '
  message="$plugin $event hook has no retained or active runtime; restart this Codex session."
  if [ "$event" = "PreToolUse" ]; then
    printf '%sif [ ! -x "$hook_entry" ]; then printf '\''%%s\\n'\'' '\''%s'\'' >&2; exit 2; fi; %s"$hook_entry"%s\n' \
      "$bootstrap" "$message" "$prefix" "$trailing"
    return 0
  fi

  printf '%sif [ ! -x "$hook_entry" ]; then printf '\''%%s\\n'\'' '\''{"systemMessage":"%s"}'\''; exit 0; fi; %s"$hook_entry"%s\n' \
    "$bootstrap" "$message" "$prefix" "$trailing"
}

write_codex_hooks_config() {
  local plugin="$1" source="$2" target="$3" event group_index hook_index command wrapped temporary
  cp -p "$source" "$target"
  while IFS=$'\t' read -r event group_index hook_index command; do
    wrapped="$(codex_hook_command "$plugin" "$event" "$command")"
    temporary="$target.tmp"
    jq --tab --arg event "$event" --argjson group "$group_index" --argjson hook "$hook_index" --arg command "$wrapped" \
      '.hooks[$event][$group].hooks[$hook].command = $command' "$target" > "$temporary"
    mv "$temporary" "$target"
  done < <(jq -r '
    .hooks | to_entries[] |
    .key as $event |
    .value | to_entries[] |
    .key as $group |
    .value.hooks | to_entries[] |
    select(.value.type == "command") |
    [$event, $group, .key, .value.command] | @tsv
  ' "$source")
}

is_tombstone_manifest() {
	local manifest="$1"
	jq -e '(.description // "") | startswith("DEPRECATED:")' "$manifest" >/dev/null
}

skill_source_for_agent() {
  local skill_dir="$1" agent="$2"
  if [ -f "$skill_dir/SKILL.claude.md" ] || [ -f "$skill_dir/SKILL.codex.md" ]; then
    [ -f "$skill_dir/SKILL.$agent.md" ] || return 1
    printf '%s\n' "$skill_dir/SKILL.$agent.md"
  elif [ -f "$skill_dir/SKILL.md" ]; then
    printf '%s\n' "$skill_dir/SKILL.md"
  else
    return 1
  fi
}

validate_skill_sources() {
  local plugin="$1" plugin_dir="$2" skill_dir skill
  for skill_dir in "$plugin_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill="$(basename "$skill_dir")"
    [ -f "$skill_dir/SKILL.md" ] || [ -f "$skill_dir/SKILL.claude.md" ] || [ -f "$skill_dir/SKILL.codex.md" ] ||
      die "plugin $plugin skill $skill has no source (SKILL.md, SKILL.claude.md, or SKILL.codex.md)"
  done
}

copy_skill_file() {
  local src="$1" out="$2" sanitize="$3"
  mkdir -p "$(dirname "$out")"
  if [ "$sanitize" -eq 1 ]; then
    awk 'tolower($0) !~ /^[[:space:]]*(argument[-_]hint|disable[-_]model[-_]invocation|effort|optional|scope|user[-_]invocable):/' "$src" > "$out"
  else
    cp "$src" "$out"
  fi
}

copy_claude_skill_targets() {
  local repo="$1" out_root="$2" plugin_dir="$3" skill_dir rel src out
  for skill_dir in "$plugin_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.claude.md" ] || continue
    src="$skill_dir/SKILL.claude.md"
    rel="${skill_dir#$repo/}/SKILL.md"
    out="$out_root/$rel"
    copy_skill_file "$src" "$out" 0
  done
}

copy_codex_skills() {
  local plugin_dir="$1" target_dir="$2" file rel out skill_dir src
  rm -rf "$target_dir/skills"
  mkdir -p "$target_dir/skills"
  while IFS= read -r file; do
    case "$(basename "$file")" in
      SKILL.md|SKILL.claude.md|SKILL.codex.md) continue ;;
    esac
    rel="${file#$plugin_dir/}"
    out="$target_dir/$rel"
    mkdir -p "$(dirname "$out")"
    cp "$file" "$out"
  done < <(find "$plugin_dir/skills" -type f | sort)
  for skill_dir in "$plugin_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    if ! src="$(skill_source_for_agent "$skill_dir" codex)"; then
      continue
    fi
    rel="${skill_dir#$plugin_dir/}/SKILL.md"
    copy_skill_file "$src" "$target_dir/$rel" 1
  done
}

copy_codex_runtime_payload() {
  local plugin_dir="$1" target_dir="$2" dir file rel out
  rm -rf "$target_dir/bin" "$target_dir/lib" "$target_dir/templates"
  for dir in bin lib templates; do
    [ -d "$plugin_dir/$dir" ] || continue
    while IFS= read -r file; do
      rel="${file#$plugin_dir/}"
      out="$target_dir/$rel"
      mkdir -p "$(dirname "$out")"
      cp -p "$file" "$out"
    done < <(find "$plugin_dir/$dir" -type f | sort)
  done
  if [ -f "$plugin_dir/package.json" ]; then
    cp -p "$plugin_dir/package.json" "$target_dir/package.json"
  fi
}

copy_codex_root_files() {
  local plugin_dir="$1" target_dir="$2" rel
  for rel in CHANGELOG.md MARKETPLACE-CHANGELOG.md; do
    [ -f "$plugin_dir/$rel" ] || continue
    cp -p "$plugin_dir/$rel" "$target_dir/$rel"
  done
}

copy_codex_agents() {
  local plugin_dir="$1" target_dir="$2" file rel out codex_agents_dir
  rm -rf "$target_dir/agents"
  codex_agents_dir="$plugin_dir/agents.codex"
  [ -d "$codex_agents_dir" ] || return 0
  while IFS= read -r file; do
    rel="${file#$codex_agents_dir/}"
    out="$target_dir/agents/$rel"
    mkdir -p "$(dirname "$out")"
    cp -p "$file" "$out"
  done < <(find "$codex_agents_dir" -type f | sort)
}

copy_codex_hooks() {
  local plugin="$1" plugin_dir="$2" target_dir="$3" file rel out
  rm -rf "$target_dir/hooks"

  if has_codex_hooks "$plugin_dir"; then
    while IFS= read -r file; do
      rel="${file#$plugin_dir/}"
      case "$rel" in
	hooks/hooks.json|hooks/hooks.codex.json) continue ;;
      esac
      out="$target_dir/$rel"
      mkdir -p "$(dirname "$out")"
      cp -p "$file" "$out"
    done < <(find "$plugin_dir/hooks" -type f | sort)
    mkdir -p "$target_dir/hooks"
    write_codex_hooks_config "$plugin" "$plugin_dir/hooks/hooks.codex.json" "$target_dir/hooks/hooks.json"
    return 0
  fi

  [ -d "$plugin_dir/hooks/lib" ] || return 0
  while IFS= read -r file; do
    rel="${file#$plugin_dir/}"
    out="$target_dir/$rel"
    mkdir -p "$(dirname "$out")"
    cp -p "$file" "$out"
  done < <(find "$plugin_dir/hooks/lib" -type f | sort)
}

generated_claude_skill_targets() {
  local root="$1" file
  while IFS= read -r file; do
    printf '%s/SKILL.md\n' "$(dirname "$file")"
  done < <(find "$root" -not -path "*/worktrees/*" -path "*/skills/*/SKILL.claude.md" -type f 2>/dev/null | sort)
}

generate_into() {
  local repo="$1" out_root="$2"
  require_marketplace "$repo"
  mkdir -p "$out_root/.agents/plugins"

  local entries_file marketplace_name market_display
  entries_file="$out_root/.agents/plugins/.entries.jsonl"
  : > "$entries_file"

  local name source plugin_dir manifest target_dir codex_source
  while IFS=$'\t' read -r name source; do
    validate_source "$name" "$source"
    plugin_dir="$repo/${source#./}"
    manifest="$plugin_dir/.claude-plugin/plugin.json"
    [ -f "$manifest" ] || die "plugin $name is missing .claude-plugin/plugin.json"
    if [ ! -d "$plugin_dir/skills" ]; then
	  if is_tombstone_manifest "$manifest"; then
	    rm -rf "$out_root/.agents/plugins/generated/$name"
	    rm -rf "$out_root/${source#./}/.codex-plugin"
	    continue
	  fi
	  die "plugin $name is missing skills/"
    fi
    validate_skill_sources "$name" "$plugin_dir"
    copy_claude_skill_targets "$repo" "$out_root" "$plugin_dir"
    if has_codex_hooks "$plugin_dir"; then
      validate_codex_hooks_config "$name" "$plugin_dir/hooks/hooks.codex.json"
    fi

    if ! has_skill_source_for_agent "$plugin_dir" codex && [ ! -d "$plugin_dir/agents.codex" ] && ! has_codex_hooks "$plugin_dir"; then
      rm -rf "$out_root/.agents/plugins/generated/$name"
      rm -rf "$out_root/${source#./}/.codex-plugin"
      continue
    fi

    if has_agent_specific_skills "$plugin_dir" || needs_sanitized_skills "$plugin_dir" || [ -d "$plugin_dir/agents.codex" ] || has_codex_hooks "$plugin_dir"; then
      codex_source="./.agents/plugins/generated/$name"
      target_dir="$out_root/.agents/plugins/generated/$name"
      rm -rf "$target_dir"
      rm -rf "$out_root/${source#./}/.codex-plugin"
      mkdir -p "$target_dir/.codex-plugin"
      copy_codex_skills "$plugin_dir" "$target_dir"
      copy_codex_runtime_payload "$plugin_dir" "$target_dir"
      copy_codex_root_files "$plugin_dir" "$target_dir"
      copy_codex_agents "$plugin_dir" "$target_dir"
      copy_codex_hooks "$name" "$plugin_dir" "$target_dir"
      if has_codex_hooks "$plugin_dir"; then
		codex_plugin_payload "$manifest" "$name" "$CODEX_HOOK_ADAPTER_REVISION" > "$target_dir/.codex-plugin/plugin.json"
      else
		codex_plugin_payload "$manifest" "$name" > "$target_dir/.codex-plugin/plugin.json"
      fi
    else
      if [ -f "$plugin_dir/hooks/hooks.json" ]; then
				validate_codex_hooks_config "$name" "$plugin_dir/hooks/hooks.json"
      fi
      codex_source="$source"
      target_dir="$out_root/${source#./}/.codex-plugin"
      rm -rf "$out_root/.agents/plugins/generated/$name"
      mkdir -p "$target_dir"
      codex_plugin_payload "$manifest" "$name" > "$target_dir/plugin.json"
    fi

    codex_marketplace_entry "$name" "$codex_source" >> "$entries_file"
  done < <(jq -r '.plugins[] | [.name, .source] | @tsv' "$repo/$CLAUDE_MARKETPLACE_FILE")

  marketplace_name="$(jq -r '.name' "$repo/$CLAUDE_MARKETPLACE_FILE")"
  market_display="$(jq -r '.owner.name // .interface.displayName // .displayName // empty' "$repo/$CLAUDE_MARKETPLACE_FILE")"
  [ -n "$market_display" ] || market_display="$(display_name "$marketplace_name")"

  jq -s --arg name "$marketplace_name" --arg display "$market_display" '
    {
      name: $name,
      interface: {
	displayName: $display
      },
      plugins: .
    }
  ' "$entries_file" > "$out_root/$CODEX_MARKETPLACE_FILE"
  rm -f "$entries_file"
}

expected_files() {
  local out_root="$1"
  {
    find "$out_root/.agents/plugins" -type f 2>/dev/null || true
    find "$out_root" -path "*/.codex-plugin/plugin.json" -type f 2>/dev/null
    find "$out_root" -path "*/skills/*/SKILL.md" -type f 2>/dev/null
  } | sort -u
}

actual_files() {
  local repo="$1"
  {
    find "$repo/.agents/plugins" -type f 2>/dev/null || true
    find "$repo" -not -path "*/worktrees/*" -path "*/.codex-plugin/plugin.json" -type f 2>/dev/null
    generated_claude_skill_targets "$repo"
  } | sort -u
}

prune_empty_parents() {
  local repo="$1" dir="$2"
  while [ -n "$dir" ] && [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    rmdir "$repo/$dir" 2>/dev/null || break
    dir="$(dirname "$dir")"
  done
}

# Publish a staged build into the repository without ever taking a generated
# file away. Git hooks and Codex sessions run straight out of the generated
# tree, so each target is replaced by an atomic rename within its own
# directory: a reader sees either the old file or the new one, never a gap.
# Targets that the build no longer produces are removed afterwards, which is
# what keeps a dropped adapter from lingering as drift.
publish_generated() {
  local staged="$1" repo="$2" rel target expected_rel actual_rel
  expected_rel="$staged/.circus-publish-expected"
  actual_rel="$staged/.circus-publish-actual"
  expected_files "$staged" | sed "s#^$staged/##" | sort -u > "$expected_rel"
  actual_files "$repo" | sed "s#^$repo/##" | sort -u > "$actual_rel"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    target="$repo/$rel"
    if [ -f "$target" ] && cmp -s "$staged/$rel" "$target"; then
      continue
    fi
    mkdir -p "$(dirname "$target")"
    cp -p "$staged/$rel" "$target.circus-new"
    mv -f "$target.circus-new" "$target"
  done < "$expected_rel"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rm -f "$repo/$rel"
    prune_empty_parents "$repo" "$(dirname "$rel")"
  done < <(comm -13 "$expected_rel" "$actual_rel")

  rm -f "$expected_rel" "$actual_rel"
}

cmd_build() {
  local repo staged
  repo="$(repo_root "${1:-$PWD}")"
  staged="$(mktemp -d)"
  trap "rm -rf '$staged'" EXIT
  generate_into "$repo" "$staged"
  publish_generated "$staged" "$repo"
  printf 'circus plugins: wrote %s and .codex-plugin manifests (%s)\n' "$CODEX_MARKETPLACE_FILE" "$repo"
}

cmd_check() {
  local repo tmp expected rel rc=0 expected_rel actual_rel unexpected
  repo="$(repo_root "${1:-$PWD}")"
  tmp="$(mktemp -d)"
  trap "rm -rf '$tmp'" EXIT
  generate_into "$repo" "$tmp"
  expected_rel="$tmp/expected.txt"
  actual_rel="$tmp/actual.txt"
  expected_files "$tmp" | sed "s#^$tmp/##" > "$expected_rel"
  actual_files "$repo" | sed "s#^$repo/##" > "$actual_rel"

  while IFS= read -r expected; do
    rel="${expected#$tmp/}"
    if [ ! -f "$repo/$rel" ]; then
      printf 'DRIFT  %s missing\n' "$rel"
      rc=1
    elif cmp -s "$repo/$rel" "$expected"; then
      printf 'ok     %s\n' "$rel"
    else
      printf 'DRIFT  %s differs from Claude marketplace source\n' "$rel"
      rc=1
    fi
  done < <(expected_files "$tmp")
  while IFS= read -r unexpected; do
    [ -n "$unexpected" ] || continue
    printf 'DRIFT  %s is an unexpected generated adapter target\n' "$unexpected"
    rc=1
  done < <(comm -13 "$expected_rel" "$actual_rel")
  return "$rc"
}

cmd_diff() {
  local repo tmp expected rel
  repo="$(repo_root "${1:-$PWD}")"
  tmp="$(mktemp -d)"
  trap "rm -rf '$tmp'" EXIT
  generate_into "$repo" "$tmp"

  while IFS= read -r expected; do
    rel="${expected#$tmp/}"
    printf '=== %s ===\n' "$rel"
    if [ -f "$repo/$rel" ]; then
      diff -u "$repo/$rel" "$expected" || true
    else
      printf '(target does not exist)\n'
      cat "$expected"
    fi
  done < <(expected_files "$tmp")
}

usage() {
  cat <<'EOF'
plugin-adapters - build agent-specific plugin metadata from Claude marketplace source

  circus plugins build [repo]   write .agents/plugins and .codex-plugin manifests
  circus plugins check [repo]   report drift between source and generated targets
  circus plugins diff [repo]    show generated target diffs
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  build) cmd_build "$@" ;;
  check) cmd_check "$@" ;;
  diff)  cmd_diff "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd" ;;
esac
