#!/usr/bin/env node
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseInvocation, helpText } from '../lib/cli.mjs';
import { installMachineRuntime, sourceRuntimeVersion } from '../lib/machine-runtime.mjs';
import { installLaunchAgent, launchAgentIsInstalled, launchAgentNeedsReconciliation, runCommand } from '../lib/runtime.mjs';

const sourceRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
const sourceVersion = sourceRuntimeVersion(sourceRoot);

const inv = parseInvocation(process.argv.slice(2));

if (inv.kind === 'help') {
  process.stdout.write(`${helpText()}\n`);
  process.exit(0);
}

if (inv.kind === 'unknown') {
  process.stderr.write(`vaultsync: unknown command '${inv.command}'\n\n${helpText()}\n`);
  process.exit(2);
}

try {
  const publication = installMachineRuntime({ sourceRoot, version: sourceVersion });
  if (inv.command === 'runtime') {
    if (inv.args.length !== 1 || inv.args[0] !== 'install') throw new Error('usage: vaultsync runtime install');
    if (launchAgentIsInstalled() && (publication.installed || launchAgentNeedsReconciliation(publication.version))) {
      installLaunchAgent(process.env, publication.version);
    }
    process.stdout.write(`Vaultsync ${publication.version} machine runtime ready at ${publication.launcher}.\n`);
    process.exit(0);
  }
  await runCommand(inv.command, inv.args);
} catch (err) {
  process.stderr.write(`vaultsync: ${err.message}\n`);
  if (err.detail) process.stderr.write(`${err.detail}\n`);
  process.exit(err.exitCode || 1);
}
