#!/usr/bin/env node

import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readFileSync, realpathSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { publishGitDisciplineRuntime } from './machine-runtime.mjs';

class GitDisciplineError extends Error {
  constructor(message, exitCode = 1) {
    super(message);
    this.exitCode = exitCode;
  }
}

function runGit(argumentsList, options = {}) {
  const result = spawnSync('git', argumentsList, {
    cwd: options.cwd ?? process.cwd(),
    encoding: 'utf8',
    input: options.input,
    stdio: options.stdio ?? ['pipe', 'pipe', 'pipe'],
  });

  if (result.error) {
    throw new GitDisciplineError(`git ${argumentsList[0]} failed: ${result.error.message}`);
  }
  if (options.allowFailure || result.status === 0) {
    return {
      status: result.status ?? 1,
      stdout: result.stdout?.trim() ?? '',
      stderr: result.stderr?.trim() ?? '',
    };
  }

  const detail = result.stderr?.trim() || result.stdout?.trim() || `exit ${result.status}`;
  throw new GitDisciplineError(`git ${argumentsList.join(' ')} failed: ${detail}`, result.status ?? 1);
}

function gitOutput(argumentsList, options = {}) {
  return runGit(argumentsList, options).stdout;
}

function refExists(reference) {
  return runGit(['rev-parse', '--verify', '--quiet', reference], { allowFailure: true }).status === 0;
}

function defaultBranch() {
  const originHead = runGit(
    ['symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD'],
    { allowFailure: true },
  );
  if (originHead.status === 0 && originHead.stdout.startsWith('origin/')) {
    return originHead.stdout.slice('origin/'.length);
  }

  const configured = runGit(['config', '--local', '--get', 'init.defaultBranch'], { allowFailure: true });
  if (configured.status === 0 && refExists(`refs/heads/${configured.stdout}`)) {
    return configured.stdout;
  }

  throw new GitDisciplineError(
    "Cannot determine the default branch. Run git remote set-head origin -a, or set local init.defaultBranch to the existing default branch.",
  );
}

function currentBranch() {
  const result = runGit(['symbolic-ref', '--quiet', '--short', 'HEAD'], { allowFailure: true });
  if (result.status !== 0) {
    throw new GitDisciplineError('HEAD is detached; a candidate must be checked out on a branch.');
  }
  return result.stdout;
}

function legacyWorktreeRequirement() {
  const configured = runGit(
    ['config', '--local', '--bool', '--get', 'laicluse.requireWorktree'],
    { allowFailure: true },
  );
  if (configured.status === 1) return false;
  if (configured.status !== 0) {
    throw new GitDisciplineError(
      `Cannot read local laicluse.requireWorktree: ${configured.stderr || `exit ${configured.status}`}`,
    );
  }
  return configured.stdout === 'true';
}

function repositoryBranchPolicy() {
  const configured = runGit(['config', '--local', '--get', 'codingAgent.git.branchPolicy'], { allowFailure: true });
  const aliases = { current: 'feature', default: 'trunk' };
  const policy = configured.status === 1 ? 'feature' : aliases[configured.stdout] ?? configured.stdout;
  if (![0, 1].includes(configured.status) || !['feature', 'trunk', 'worktree'].includes(policy)) {
    throw new GitDisciplineError('Local codingAgent.git.branchPolicy must be feature, trunk or worktree.');
  }
  return legacyWorktreeRequirement() ? 'worktree' : policy;
}

function isPrimaryCheckout() {
  return realpathSync(gitOutput(['rev-parse', '--absolute-git-dir'])) === gitCommonDirectory();
}

function authoringPlan() {
  const policy = repositoryBranchPolicy();
  const primary = isPrimaryCheckout();
  const branchName = runGit(['symbolic-ref', '--quiet', '--short', 'HEAD'], { allowFailure: true }).stdout;
  const rebaseDirectory = ['rebase-merge', 'rebase-apply'].map((name) => gitOutput(['rev-parse', '--git-path', name]))
    .find((directory) => existsSync(join(directory, 'head-name')) && !existsSync(join(directory, 'applying')));
  const rebaseHead = rebaseDirectory ? readFileSync(join(rebaseDirectory, 'head-name'), 'utf8').trim() : '';
  const rebaseBranch = rebaseHead.startsWith('refs/heads/') ? rebaseHead.slice('refs/heads/'.length) : '';
  const writingBranch = branchName || rebaseBranch;
  const initializing = !refExists('HEAD') && !gitOutput(['for-each-ref', '--format=%(refname)', 'refs/heads/']);
  const worktreeRequired = policy === 'worktree';
  let authoringBranch = writingBranch;
  let action = branchName ? 'author' : 'complete-rebase';
  if (refExists('MERGE_HEAD')) {
    action = 'complete-merge';
  } else if (!writingBranch) {
    action = 'attach-branch';
  } else if (initializing) {
    action = 'initialize-repository';
  } else if (worktreeRequired && primary) {
    authoringBranch = '';
    action = 'create-worktree';
  } else {
    const defaultName = defaultBranch();
    if (policy === 'trunk' && primary) {
      authoringBranch = defaultName;
      if (writingBranch !== defaultName) action = 'return-to-default';
    } else if (writingBranch === defaultName) {
      authoringBranch = '';
      action = 'create-feature-branch';
    }
  }
  return { policy, primary, branchName, authoringBranch, action, worktreeRequired };
}

function branchPolicyCommand() {
  const plan = authoringPlan();
  process.stdout.write(`policy=${plan.policy}\ncheckout=${plan.primary ? 'primary' : 'linked'}\ncurrent_branch=${plan.branchName}\nauthoring_branch=${plan.authoringBranch}\nworktree_required=${plan.worktreeRequired}\naction=${plan.action}\n`);
}

function requireCleanWorktree() {
  if (gitOutput(['status', '--porcelain'])) {
    throw new GitDisciplineError('Working tree is dirty; commit the candidate before continuing.');
  }
}

function targetFrom(argumentsList) {
  const local = argumentsList.includes('--local');
  const remote = argumentsList.includes('--remote');
  if (local === remote) {
    throw new GitDisciplineError('Choose exactly one target: --local or --remote.');
  }
  return local ? 'local' : 'remote';
}

function localDefaultTip(branchName) {
  const reference = `refs/heads/${branchName}`;
  if (!refExists(reference)) {
    throw new GitDisciplineError(`Local default branch ${branchName} does not exist.`);
  }
  return gitOutput(['rev-parse', reference]);
}

function remoteDefaultTip(branchName) {
  const result = runGit(
    ['ls-remote', '--exit-code', 'origin', `refs/heads/${branchName}`],
    { allowFailure: true },
  );
  if (result.status !== 0 || !result.stdout) {
    const detail = result.stderr || `origin/${branchName} does not exist`;
    throw new GitDisciplineError(`Cannot read the remote default branch: ${detail}`);
  }
  return result.stdout.split(/\s+/)[0];
}

function defaultTip(target, branchName) {
  return target === 'local' ? localDefaultTip(branchName) : remoteDefaultTip(branchName);
}

function worktreesCheckingOut(branchName) {
  const branchReference = `refs/heads/${branchName}`;
  const fields = runGit(['worktree', 'list', '--porcelain', '-z']).stdout.split('\0');
  const matches = [];
  let worktreePath = null;

  for (const field of fields) {
    if (field.startsWith('worktree ')) {
      worktreePath = field.slice('worktree '.length);
    } else if (field === `branch ${branchReference}` && worktreePath) {
      matches.push(worktreePath);
    }
  }

  return matches;
}

function requireCandidateBranch(branchName) {
  const activeBranch = currentBranch();
  if (activeBranch === branchName) {
    throw new GitDisciplineError(`The candidate cannot be the default branch ${branchName}.`);
  }
  return activeBranch;
}

function isAncestor(ancestor, descendant) {
  return runGit(['merge-base', '--is-ancestor', ancestor, descendant], { allowFailure: true }).status === 0;
}

function gitCommonDirectory() {
  const absolute = runGit(['rev-parse', '--path-format=absolute', '--git-common-dir'], { allowFailure: true });
  if (absolute.status === 0) {
    return realpathSync(absolute.stdout);
  }
  const repositoryRoot = gitOutput(['rev-parse', '--show-toplevel']);
  return realpathSync(resolve(repositoryRoot, gitOutput(['rev-parse', '--git-common-dir'])));
}

function repositoryStateDirectory() {
  const repositoryKey = createHash('sha256').update(gitCommonDirectory()).digest('hex').slice(0, 24);
  const laicluseHome = process.env.LAICLUSE_HOME || join(homedir(), '.laicluse');
  return join(laicluseHome, 'git-discipline', 'candidates', repositoryKey);
}

function proofPath(candidate, target) {
  return join(repositoryStateDirectory(), `${candidate}.${target}.json`);
}

function removeProof(candidate, target) {
  rmSync(proofPath(candidate, target), { force: true });
}

function writeProof(proof) {
  const destination = proofPath(proof.candidate, proof.target);
  mkdirSync(dirname(destination), { recursive: true });
  const temporary = `${destination}.${process.pid}.tmp`;
  writeFileSync(temporary, `${JSON.stringify(proof, null, 2)}\n`, { mode: 0o600 });
  renameSync(temporary, destination);
}

function readProof(candidate, target) {
  const path = proofPath(candidate, target);
  if (!existsSync(path)) {
    throw new GitDisciplineError(`Candidate ${candidate.slice(0, 12)} has no passing verification for ${target}.`);
  }
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch (error) {
    throw new GitDisciplineError(`Candidate verification is unreadable: ${error.message}`);
  }
}

function validateProof(candidate, base, branchName, target) {
  const proof = readProof(candidate, target);
  if (proof.version !== 1 || proof.candidate !== candidate || proof.defaultBranch !== branchName) {
    throw new GitDisciplineError(`Candidate ${candidate.slice(0, 12)} verification does not match the current repository state.`);
  }
  if (proof.base !== base) {
    throw new GitDisciplineError(
      `The default branch moved from ${proof.base.slice(0, 12)} to ${base.slice(0, 12)}; rebase and verify the candidate again.`,
    );
  }
  if (proof.tree !== gitOutput(['rev-parse', `${candidate}^{tree}`])) {
    throw new GitDisciplineError(`Candidate ${candidate.slice(0, 12)} tree no longer matches its verification.`);
  }
  if (!isAncestor(base, candidate)) {
    throw new GitDisciplineError('Candidate is not a descendant of the current default branch; rebase and verify it again.');
  }
  return proof;
}

function rebaseCommand(argumentsList) {
  const target = targetFrom(argumentsList);
  const branchName = defaultBranch();
  requireCandidateBranch(branchName);
  requireCleanWorktree();

  let base;
  if (target === 'local') {
    base = localDefaultTip(branchName);
  } else {
    remoteDefaultTip(branchName);
    runGit(['fetch', '--no-tags', 'origin', `refs/heads/${branchName}`], { stdio: 'inherit' });
    base = gitOutput(['rev-parse', 'FETCH_HEAD']);
  }

  const candidate = gitOutput(['rev-parse', 'HEAD']);
  if (isAncestor(base, candidate)) {
    requireUniqueMigrationVersions();
    process.stdout.write(`Candidate is already based on ${base.slice(0, 12)}.\n`);
    return;
  }

  runGit(['rebase', base], { stdio: 'inherit' });
  requireUniqueMigrationVersions();
  process.stdout.write(`Rebased ${currentBranch()} onto ${base.slice(0, 12)}.\n`);
}

function verifyCommand(argumentsList) {
  const separator = argumentsList.indexOf('--');
  if (separator < 0 || separator === argumentsList.length - 1) {
    throw new GitDisciplineError('Verification requires a command after --.');
  }
  const target = targetFrom(argumentsList.slice(0, separator));
  const verificationCommand = argumentsList.slice(separator + 1);
  const branchName = defaultBranch();
  const featureBranch = requireCandidateBranch(branchName);
  requireCleanWorktree();
  const candidate = gitOutput(['rev-parse', 'HEAD']);
  const base = defaultTip(target, branchName);
  if (!isAncestor(base, candidate)) {
    throw new GitDisciplineError('Candidate is not a descendant of the current default branch; rebase it before verification.');
  }

  removeProof(candidate, target);
  const result = spawnSync(verificationCommand[0], verificationCommand.slice(1), {
    cwd: process.cwd(),
    stdio: 'inherit',
  });
  const exitCode = result.error?.code === 'ENOENT' ? 127 : (result.status ?? 1);
  if (exitCode !== 0) {
    throw new GitDisciplineError(`Verification command failed with exit ${exitCode}.`, exitCode);
  }

  writeProof({
    version: 1,
    candidate,
    tree: gitOutput(['rev-parse', `${candidate}^{tree}`]),
    base,
    defaultBranch: branchName,
    branch: featureBranch,
    target,
    command: verificationCommand,
    verifiedAt: new Date().toISOString(),
  });
  process.stdout.write(`Verified ${candidate.slice(0, 12)} against ${base.slice(0, 12)} (${target}).\n`);
}

function createMergeCommit(branchName, base, candidate, proof) {
  const tree = gitOutput(['rev-parse', `${candidate}^{tree}`]);
  const message = [
    `Merge branch '${branchName}'`,
    '',
    `Candidate ${candidate.slice(0, 12)} was verified against ${base.slice(0, 12)} with:`,
    proof.command.join(' '),
    '',
    'Slice: merge',
    'PII-Doublecheck: yes',
    '',
  ].join('\n');
  return runGit(['commit-tree', tree, '-p', base, '-p', candidate], { input: message }).stdout;
}

function claimDefaultCheckout(checkout) {
  const candidates = [process.env.DIBS_BIN, join(process.env.LAICLUSE_HOME || join(homedir(), '.laicluse'), 'dibs', 'runtime', 'dibs')].filter(Boolean);
  const dibs = candidates.find((candidate) => existsSync(candidate));
  if (!dibs) return;
  const resolved = spawnSync(dibs, ['resolve'], { input: JSON.stringify({ cwd: checkout, tool_input: { workdir: checkout } }), encoding: 'utf8' });
  if (resolved.status !== 0) throw new GitDisciplineError('Cannot resolve available Dibs coordination before updating the default checkout.');
  let context;
  try { context = JSON.parse(resolved.stdout); } catch { throw new GitDisciplineError('Cannot parse Dibs coordination context before updating the default checkout.'); }
  const args = ['claim', checkout, '--description', 'integrate verified candidate', '--json'];
  for (const field of ['agent', 'session', 'owner']) if (context[field]) args.push(`--${field}`, context[field]);
  const claimed = spawnSync(dibs, args, { encoding: 'utf8' });
  if (claimed.status !== 0) {
    let holder;
    try { holder = JSON.parse(claimed.stdout).holder; } catch {}
    throw new GitDisciplineError(`The checked-out default is occupied or unavailable through Dibs${holder ? `: ${holder.agent} (pid ${holder.pid}), ${holder.description || 'purpose unknown'}` : ''}.`);
  }
}

function updateLocalDefault(branchName, mergeCommit, base) {
  const defaultWorktrees = worktreesCheckingOut(branchName);
  if (defaultWorktrees.length > 1) {
    throw new GitDisciplineError(
      `Local default branch ${branchName} is checked out in multiple worktrees; refusing an ambiguous update.`,
    );
  }

  if (defaultWorktrees.length === 0) {
    const update = runGit(
      ['update-ref', `refs/heads/${branchName}`, mergeCommit, base],
      { allowFailure: true },
    );
    if (update.status !== 0) {
      throw new GitDisciplineError(`The default branch moved during merge: ${update.stderr || update.stdout}`);
    }
    return;
  }

  const defaultWorktree = defaultWorktrees[0];
  claimDefaultCheckout(defaultWorktree);
  const trackedStatus = ['status', '--porcelain', '--untracked-files=no'];
  if (gitOutput(trackedStatus, { cwd: defaultWorktree })) {
    throw new GitDisciplineError(
      `The checked-out default worktree is not clean: ${defaultWorktree}`,
    );
  }

  const push = runGit(
    [
      'push',
      '--no-verify',
      '--porcelain',
      `--force-with-lease=refs/heads/${branchName}:${base}`,
      '--receive-pack=git -c receive.denyCurrentBranch=updateInstead receive-pack',
      defaultWorktree,
      `${mergeCommit}:refs/heads/${branchName}`,
    ],
    { allowFailure: true },
  );
  if (push.status === 0) return;

  if (localDefaultTip(branchName) !== base) {
    throw new GitDisciplineError(`The default branch moved during merge: ${push.stderr || push.stdout}`);
  }
  if (gitOutput(trackedStatus, { cwd: defaultWorktree })) {
    throw new GitDisciplineError(
      `The checked-out default worktree is not clean: ${defaultWorktree}`,
    );
  }
  throw new GitDisciplineError(`Local default update failed: ${push.stderr || push.stdout}`);
}

function mergeCommand(argumentsList) {
  const target = targetFrom(argumentsList);
  const defaultName = defaultBranch();
  const featureBranch = requireCandidateBranch(defaultName);
  requireCleanWorktree();
  const candidate = gitOutput(['rev-parse', 'HEAD']);
  const base = defaultTip(target, defaultName);
  const proof = validateProof(candidate, base, defaultName, target);
  const mergeCommit = createMergeCommit(featureBranch, base, candidate, proof);

  if (target === 'local') {
    updateLocalDefault(defaultName, mergeCommit, base);
  } else {
    const push = runGit(
      ['push', 'origin', `${mergeCommit}:refs/heads/${defaultName}`],
      { allowFailure: true },
    );
    if (push.status !== 0) {
      const currentRemoteTip = remoteDefaultTip(defaultName);
      if (currentRemoteTip !== base) throw new GitDisciplineError(`The default branch moved during merge; the non-force push lost the race: ${push.stderr || push.stdout}`);
      throw new GitDisciplineError(`Remote rejected the merge push: ${push.stderr || push.stdout}`);
    }
  }

  process.stdout.write(`Merged ${candidate.slice(0, 12)} as ${mergeCommit.slice(0, 12)} on ${target} ${defaultName}.\n`);

  // The merge is the only thing a candidate worktree exists for, so the moment
  // it lands the worktree is stale. Saying so here rather than only in the
  // skill puts the next step in front of the reader exactly when it applies,
  // instead of in a document they read before the merge and have to remember
  // afterwards.
  const staleWorktree = linkedWorktreeRoot();
  if (staleWorktree) {
    process.stdout.write(`This worktree is now integrated and has nothing left to hold: remove ${staleWorktree} and branch ${featureBranch} with bonsai:prune. Deployment is not a reason to keep it; that runs from a clean deploy checkout on ${mergeCommit.slice(0, 12)}.\n`);
  }
}

// The candidate sits in a linked worktree when its own git dir differs from the
// common dir. Returns its root path, or null in the primary checkout where
// there is nothing to prune.
function linkedWorktreeRoot() {
  const own = runGit(['rev-parse', '--path-format=absolute', '--git-dir'], { allowFailure: true });
  if (own.status !== 0) return null;
  let ownDir;
  let commonDir;
  try {
    ownDir = realpathSync(own.stdout);
    commonDir = gitCommonDirectory();
  } catch {
    return null;
  }
  if (ownDir === commonDir) return null;
  const root = runGit(['rev-parse', '--show-toplevel'], { allowFailure: true });
  return root.status === 0 ? root.stdout : null;
}

function requireUniqueMigrationVersions() {
  const migrations = new Map();
  for (const path of new Set(gitOutput(['ls-files', '--cached', '-z']).split('\0'))) {
    const match = path.match(/^((?:.*\/)?db\/migrate)\/(\d+)_[^/]+\.rb$/);
    if (!match) continue;
    const key = `${match[1]}/${BigInt(match[2])}`;
    const previous = migrations.get(key);
    if (previous) {
      throw new GitDisciplineError(
        `Duplicate Rails migration version: ${previous} and ${path}. Use rails generate migration for new migrations and check versions after stacking or rebasing. Do not renumber a deployed migration without a verified deployment-history repair.`,
      );
    }
    migrations.set(key, path);
  }
}

function guardCommitCommand() {
  requireUniqueMigrationVersions();
  const plan = authoringPlan();
  if (['author', 'complete-merge', 'complete-rebase', 'initialize-repository'].includes(plan.action)) return;
  if (plan.action === 'attach-branch') {
    throw new GitDisciplineError('Attach this checkout to a feature branch before ordinary commits; a paused rebase may still complete.');
  }
  if (plan.action === 'create-worktree') {
    throw new GitDisciplineError('Authoring in the primary checkout is blocked; use a linked feature worktree.');
  }
  if (plan.action === 'create-feature-branch') {
    throw new GitDisciplineError('Ordinary commits on the default branch are blocked; use a feature branch.');
  }
  throw new GitDisciplineError(`This repository requires sequential authoring on ${plan.authoringBranch} in the primary checkout. Finish the current branch through the merge workflow or use a linked worktree for isolated work.`);
}

function guardPushCommand() {
  if (!legacyWorktreeRequirement()) return;

  const defaultName = defaultBranch();
  const updates = readFileSync(0, 'utf8').split('\n').filter(Boolean);
  for (const update of updates) {
    const fields = update.trim().split(/\s+/);
    if (fields.length < 4 || fields[2] !== `refs/heads/${defaultName}`) {
      continue;
    }
    const newCommit = fields[1];
    const remoteCommit = fields[3];
    if (/^0+$/.test(newCommit) || /^0+$/.test(remoteCommit)) {
      throw new GitDisciplineError(`Creating or deleting the default branch ${defaultName} is blocked.`);
    }
    const parents = gitOutput(['show', '-s', '--format=%P', newCommit]).split(/\s+/).filter(Boolean);
    if (parents.length !== 2 || parents[0] !== remoteCommit) {
      throw new GitDisciplineError(`Default branch updates must be a two-parent merge whose first parent is the current remote tip.`);
    }
    const candidate = parents[1];
    if (gitOutput(['rev-parse', `${newCommit}^{tree}`]) !== gitOutput(['rev-parse', `${candidate}^{tree}`])) {
      throw new GitDisciplineError('Default branch merge tree must match the verified candidate tree.');
    }
    validateProof(candidate, remoteCommit, defaultName, 'remote');
  }
}

function printHelp() {
  process.stdout.write(`Usage:
  git-discipline default
  git-discipline branch-policy
  git-discipline rebase (--local|--remote)
  git-discipline verify (--local|--remote) -- <command> [args...]
  git-discipline merge (--local|--remote)
  git-discipline guard-commit
  git-discipline guard-push
  git-discipline runtime install
`);
}

function main() {
  const [command, ...argumentsList] = process.argv.slice(2);
  if (command === 'runtime' && argumentsList[0] === 'install') {
    const sourceRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
    const result = publishGitDisciplineRuntime(sourceRoot);
    process.stdout.write(`git-discipline: machine runtime ${result.version} ${result.installed ? 'installed' : 'already newer'} at ${result.launcher}\n`);
    return;
  }
  switch (command) {
    case 'default':
      process.stdout.write(`${defaultBranch()}\n`);
      break;
    case 'branch-policy':
      branchPolicyCommand();
      break;
    case 'rebase':
      rebaseCommand(argumentsList);
      break;
    case 'verify':
      verifyCommand(argumentsList);
      break;
    case 'merge':
      mergeCommand(argumentsList);
      break;
    case 'guard-commit':
      guardCommitCommand();
      break;
    case 'guard-push':
      guardPushCommand();
      break;
    case '--help':
    case '-h':
    case undefined:
      printHelp();
      break;
    default:
      throw new GitDisciplineError(`Unknown command: ${command}`);
  }
}

try {
  main();
} catch (error) {
  if (error instanceof GitDisciplineError) {
    process.stderr.write(`git-discipline: ${error.message}\n`);
    process.exit(error.exitCode);
  }
  throw error;
}
