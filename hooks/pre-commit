#!/bin/sh
#
# Setup: git config core.hooksPath hooks

if [ -f "CLAUDE.md" ] && [ -f "AGENTS.md" ]; then
  if ! cmp -s CLAUDE.md AGENTS.md; then
    echo "ERROR: CLAUDE.md and AGENTS.md drifted apart." >&2
    exit 1
  fi
fi

if [ -x "bin/check-no-symlinks" ]; then
  if ! bin/check-no-symlinks; then
    exit 1
  fi
fi

circus_script="packages/circus/bin/circus"
if [ -f ".claude-plugin/marketplace.json" ]; then
	if [ ! -x "$circus_script" ]; then
		echo "ERROR: canonical Circus executable not found at $circus_script." >&2
		exit 1
	fi
  PLUGIN_VERSIONS_GIT_CMD=$(ps -o args= -p $PPID 2>/dev/null || echo "git commit")
  export PLUGIN_VERSIONS_GIT_CMD
  if ! "$circus_script" plugins versions --staged .; then
    echo "ERROR: $circus_script plugins versions --staged failed." >&2
    exit 1
  fi
  if ! "$circus_script" plugins build . >/dev/null; then
    echo "ERROR: $circus_script plugins build failed." >&2
    exit 1
  fi
  if [ -d ".agents/plugins" ]; then
    git add -A -f ".agents/plugins"
  fi
  git ls-files "packages/*/.codex-plugin/plugin.json" | while IFS= read -r codex_manifest; do
    git add -A "$codex_manifest"
  done
  find packages -path "*/.codex-plugin/plugin.json" -type f | while IFS= read -r codex_manifest; do
    git add "$codex_manifest"
  done
  git ls-files "packages/*/skills/*/SKILL.claude.md" | while IFS= read -r claude_skill; do
    git add -A "$(dirname "$claude_skill")/SKILL.md"
  done
  find packages -path "*/skills/*/SKILL.claude.md" -type f | while IFS= read -r claude_skill; do
    git add "$(dirname "$claude_skill")/SKILL.md"
  done
  if ! "$circus_script" plugins check . >/dev/null; then
    echo "ERROR: $circus_script plugins check failed." >&2
    "$circus_script" plugins check . >&2
    exit 1
  fi
fi

pages_script="bin/build-pages"
if [ -x "$pages_script" ] && [ -f "docs/index.html" ]; then
  if ! "$pages_script" . >/dev/null; then
    echo "ERROR: $pages_script failed." >&2
    exit 1
  fi
  git add -A "docs/site-data.json" "docs/assets/og-card.svg" "docs/assets/og-image.png" "docs/index.html" "docs/agent-fieldkit"
fi

# Hand over to the operator's global hooks (git-discipline) once the
# repo-owned checks pass. A repo-local core.hooksPath replaces the global
# one instead of stacking on it, so without this exec every global hook
# would silently stop running in this repository.
global_hooks=$(git config --global core.hooksPath 2>/dev/null || true)
if [ -n "$global_hooks" ] && [ -x "$global_hooks/pre-commit" ]; then
  exec "$global_hooks/pre-commit" "$@"
fi
